(set-logic LIA)
(echo "1 b0 := @parameter0: byte:<test.Base64: boolean isPad(byte)>")
(echo "fall through")
(push)
(assert (forall ((b0 Int))
(=> true (or (<= b0 0) (> b0 0)))))
(check-sat)
(pop)
(push)
(assert (forall ((b0 Int))
(=> (or (<= b0 0) (> b0 0)) true)))
(check-sat)
(pop)
(echo "2 if b0 != 61 goto $z0 = 0:<test.Base64: boolean isPad(byte)>")
(echo "fall through")
(push)
(assert (forall ((b0 Int))
(=> (= b0 61) (= b0 61))))
(check-sat)
(pop)
(push)
(assert (forall ((b0 Int))
(=> (= b0 61) (= b0 61))))
(check-sat)
(pop)
(echo "3 $z0 = 1:<test.Base64: boolean isPad(byte)>")
(echo "fall through")
(push)
(assert (forall (($z0 Int) (b0 Int))
(=> (and (= $z0 1) (= b0 61)) (and (= $z0 1) (= b0 61)))))
(check-sat)
(pop)
(push)
(assert (forall (($z0 Int) (b0 Int))
(=> (and (= $z0 1) (= b0 61)) (and (= $z0 1) (= b0 61)))))
(check-sat)
(pop)
(echo "4 goto [?= return $z0]:<test.Base64: boolean isPad(byte)>")
(echo "fall through")
(push)
(assert (=> false true))
(check-sat)
(pop)
(push)
(assert (=> true false))
(check-sat)
(pop)
(echo "branch out")
(push)
(assert (forall (($z0 Int) (b0 Int))
(=> (and (= $z0 1) (= b0 61)) true)))
(check-sat)
(pop)
(push)
(assert (forall (($z0 Int) (b0 Int))
(=> true (and (= $z0 1) (= b0 61)))))
(check-sat)
(pop)
(echo "5 $z0 = 0:<test.Base64: boolean isPad(byte)>")
(echo "fall through")
(push)
(assert (forall (($z0 Int))
(=> (= $z0 0) (= $z0 0))))
(check-sat)
(pop)
(push)
(assert (forall (($z0 Int))
(=> (= $z0 0) (= $z0 0))))
(check-sat)
(pop)
(echo "6 return $z0:<test.Base64: boolean isPad(byte)>")
(echo "fall through")
(push)
(assert (forall (($z0 Int) (b0 Int))
(=> (and (>= $z0 0) (< $z0 0) (>= b0 0) (< b0 0)) (and (>= $z0 0) (< $z0 0) (>= b0 0) (< b0 0)))))
(check-sat)
(pop)
(push)
(assert (forall (($z0 Int) (b0 Int))
(=> (and (>= $z0 0) (< $z0 0) (>= b0 0) (< b0 0)) (and (>= $z0 0) (< $z0 0) (>= b0 0) (< b0 0)))))
