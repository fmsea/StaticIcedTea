5 i6 = 3:<test.Tribonacci: int tribonacci(int)>
fall	i6	(and (= i3 0) (= i4 1) (= i5 1) (= i6 3))

6 if i6 >= i0 goto return i5:<test.Tribonacci: int tribonacci(int)>
fall	i6	(and (>= i3 0) (>= i4 1) (>= i5 1) (>= i6 3) (<= i6 (+ i0 (- 1))))

branch	i0	(and (>= i3 0) (>= i4 1) (>= i5 1) (>= i6 3) (<= i0 (+ i6 0)))

