(echo "6 if i4 >= i0 goto return i3:<miniExample4: int example(int)>")
(echo "fall through")
(push)
(assert (forall ((i0 Int) (i4 Int))
(=> (and (>= i4 2) (<= i4 (+ i0 (- 1)))) (and (> i0 0) (> i4 0)))))
(check-sat)
(pop)
(push)
(assert (forall ((i0 Int) (i4 Int))
(=> (and (> i0 0) (> i4 0)) (and (>= i4 2) (<= i4 (+ i0 (- 1)))))))
(check-sat)
(pop)
(echo "branch out")
(push)
(assert (forall ((i0 Int) (i4 Int))
(=> (and (>= i4 2) (<= i0 (+ i4 0))) (> i4 0))))
(check-sat)
(pop)
(push)
(assert (forall ((i0 Int) (i4 Int))
(=> (> i4 0) (and (>= i4 2) (<= i0 (+ i4 0))))))
(check-sat)
(pop)
