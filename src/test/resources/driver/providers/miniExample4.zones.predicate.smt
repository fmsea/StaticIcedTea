(=> (and (= i2 (+ i3 0)) (>= i2 1)) (and (> i2 0) (> i3 0)))))
(check-sat)
(pop)
(push)
(assert (forall ((i2 Int) (i3 Int))
(=> (and (> i2 0) (> i3 0)) (and (= i2 (+ i3 0)) (>= i2 1)))))
